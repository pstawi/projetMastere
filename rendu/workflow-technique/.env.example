# Copier ce fichier en ".env" (jamais commite) et renseigner des valeurs reelles.
# Aucun secret ne doit jamais etre versionne en clair dans Gitea (cf. section D.2 / E.5 du cahier).

# Domaine racine du workflow (placeholder a remplacer avant mise en ligne)
DOMAIN_WORKFLOW=wk-<classe>-<groupe>.fr

# Email utilise pour la generation des certificats Let's Encrypt
ACME_EMAIL=contact@wk-<classe>-<groupe>.fr

# Base de donnees Gitea
GITEA_DB_PASSWORD=change_me_secret

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_secret

# Restic (sauvegardes)
RESTIC_REPOSITORY=s3:https://s3.exemple.fr/furious-ducks-backup
RESTIC_PASSWORD=change_me_secret

# Registry Docker (identifiants utilises par Jenkins pour push/pull)
REGISTRY_USER=jenkins-ci
REGISTRY_PASSWORD=change_me_secret
